{{ file_managed_by_ansible }}

{% if rhel10stig_resolv_domains is defined %}
# Domains
{% for domains in rhel10stig_resolv_domains %}
domain {{ rhel10stig_resolv_domains }}
{% endfor %}
{% endif %}
{% if rhel10stig_resolv_search_options is defined %}
# Search
search {{ rhel10stig_resolv_search_options }}
{% endif %}
{% if rhel10stig_dns_ip4_servers is defined %}
# IPv4
{% for nameserver in rhel10stig_dns_ip4_servers %}
nameserver {{ nameserver }}
{% endfor %}
{% endif %}
{% if rhel10stig_dns_ip6_servers is defined %}
# IPv6
{% for nameserver in rhel10stig_dns_ip6_servers %}
nameserver {{ nameserver }}
{% endfor %}
{% endif %}
{% if rhel10stig_resolv_dns_options is defined %}
# Options
options: rhel10stig_resolv_dns_options
{% endif %}
